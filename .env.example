# Contact form email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=priyanshu@booyaa.net
SMTP_PASS=your_google_app_password
CONTACT_TO=priyanshu@booyaa.net

# Analytics and conversion tracking. Leave unset to disable tracking entirely;
# the site renders no gtag and fires no conversions until these are provided.
# NEXT_PUBLIC_* vars are exposed to the browser (required for gtag.js).

# GA4 measurement ID (Google Analytics > Admin > Data streams). Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Ads conversion ID (Google Ads > Goals > Conversions). Format: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads conversion label for the lead action, from the same conversion
# action's tag setup. Format: AbC-D_efGhIjKl. Fires on form submission.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
